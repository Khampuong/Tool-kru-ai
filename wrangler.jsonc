{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tool-kru-ai",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "App",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "App" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["App"] }],
  "r2_buckets": [{ "binding": "BACKUP", "bucket_name": "tool-kru-ai-data" }],
  // PUBLIC_URL = URL ของ Worker นี้ (container ใช้เรียก /__backup); BACKUP_TOKEN ตั้งเป็น secret
  "vars": { "PUBLIC_URL": "" }
}
